# Copia este archivo como .streamlit/secrets.toml (NUNCA lo subas a git).
# En Streamlit Community Cloud pega el mismo contenido en Settings → Secrets.
#
# Cadena de Supabase: Project → Connect → "Session pooler" (puerto 5432, IPv4).
# La "Direct connection" (db.<ref>.supabase.co) solo funciona por IPv6.

# Claves de primer nivel (antes de cualquier [sección]): Streamlit las expone
# como variables de entorno, así el agente RAG recibe la suya en la nube.
# GROQ_API_KEY = "<tu clave de Groq>"
#
# Hash de la contraseña de administrador (NO la contraseña). Se genera con:
#   python 07_app_web/cofitech/seguridad.py
# COFITECH_ADMIN_HASH = "pbkdf2_sha256:600000:..."

[connections.postgresql]
url = "postgresql://postgres.<PROJECT_REF>:<CONTRASEÑA>@aws-0-<REGION>.pooler.supabase.com:5432/postgres"

# Alternativa por partes (si la contraseña tiene caracteres como @ : / #):
# dialect  = "postgresql"
# host     = "aws-0-<REGION>.pooler.supabase.com"
# port     = 5432
# database = "postgres"
# username = "postgres.<PROJECT_REF>"
# password = "<CONTRASEÑA>"

# Opcional: también se puede dejar en .env como SUPABASE_DB_URL=postgresql://...
